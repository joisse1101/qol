{
  "name": "joisse1101.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "dev:link": "yalc link @joisse1101/ui-library && npm run dev:force",
    "dev:update": "yalc update @joisse1101/ui-library && npm run dev:force",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "build:unlink": "yalc retreat @joisse1101/ui-library && npm update @joisse1101/ui-library && npm install && npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@joisse1101/ui-library": "^1.5.0",
    "@octokit/rest": "^22.0.1",
    "@pyscript/core": "^0.7.31",
    "@zip.js/zip.js": "^2.24.0",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "gray-matter": "^4.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "string-width": "^8.3.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sass-embedded": "^1.106.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}