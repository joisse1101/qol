{
  "name": "joisse1101.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "dev:link": "yalc link @joisse1101/ui-library && npm run dev:force",
    "dev:update": "yalc update @joisse1101/ui-library && npm run dev:force",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "build:unlink": "yalc retreat @joisse1101/ui-library && npm update @joisse1101/ui-library && npm install && npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.9",
    "@joisse1101/ui-library": "^1.0.0",
    "@octokit/rest": "^22.0.1",
    "@pyscript/core": "^0.7.31",
    "@zip.js/zip.js": "^2.8.53",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "gray-matter": "^4.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "string-width": "^8.2.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sass-embedded": "^1.102.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}